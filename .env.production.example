# 复制到服务器 /opt/neorvion/env/.env.production 后填写真实值。
# chmod 600。不要提交 Git，不要写 password123。

# ---- Compose / 镜像 ----
COMPOSE_PROJECT_NAME=neorvion
ERP_API_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/neorvion-erp/erp-api:REPLACE_WITH_SHA
GIT_SHA=unknown
APP_VERSION=1.0.0

# ---- 应用 ----
APP_NAME=Neorvion ERP
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8011
ENABLE_API_DOCS=true
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_48

JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=neorvion_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true

# 同域部署时填真实域名。不要 *，不要带 credentials 用通配。
CORS_ORIGINS=https://neorvion.com,https://www.neorvion.com

# ---- MySQL（ERP，应用禁止用 root）----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=neorvion_erp
MYSQL_USER=neorvion
MYSQL_PASSWORD=REPLACE_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_MYSQL_ROOT_PASSWORD

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_DB=0

# ---- PostgreSQL（仅未来 Agent / RAG，ERP 不连接）----
POSTGRES_DB=neorvion_agent
POSTGRES_USER=neorvion_agent
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD

# ---- RSA（容器内路径，私钥只读挂载）----
RSA_KEY_ID=v1
RSA_PRIVATE_KEY_PATH=secrets/rsa/v1/private.pem
RSA_PUBLIC_KEY_PATH=secrets/rsa/v1/public.pem
RSA_PREVIOUS_KEY_ID=
RSA_PREVIOUS_PRIVATE_KEY_PATH=
RSA_CHALLENGE_TTL_SECONDS=300

# 演示 seed 默认留空。生产自动部署禁止 seed。
DEMO_EMAIL=
DEMO_PASSWORD=
