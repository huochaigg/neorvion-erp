{
  "skill_key": "sales-order-review",
  "name": "销售订单审查",
  "description": "读取销售订单证据，给出不包含审批、改单或履约动作的只读审查结果。",
  "version": {
    "instructions": "必须使用输入中的销售订单主键查询订单。只报告工具返回的订单事实、异常线索与需要人工确认的项目，并附实际 Evidence 引用；不得猜测库存或客户资料，不得审批、修改、发货、退款或创建任何单据。",
    "input_schema": {"type": "object", "properties": {"order_id": {"type": "integer", "minimum": 1, "description": "销售订单主键，不是租户 ID 或外部订单号"}}, "required": ["order_id"]},
    "output_schema": {"type": "object", "properties": {"summary": {"type": "string", "maxLength": 4000, "description": "订单事实与审查结论"}, "issues": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}, "description": "需要人工确认的问题；无问题时为空数组"}, "evidence_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 32}}}, "required": ["summary", "issues", "evidence_refs"]},
    "allowed_agents": ["sales_agent"],
    "required_permissions": ["order:read"],
    "allowed_tools": ["get_sales_order"],
    "required_evidence": true,
    "risk_level": "READ_ONLY",
    "timeout_seconds": 30,
    "token_budget": 3000
  }
}
