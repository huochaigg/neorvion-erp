APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8013
APP_VERSION=13.0.0
GIT_SHA=
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:8015,http://localhost:8018,http://localhost:8019,http://127.0.0.1:8015,http://127.0.0.1:8018,http://127.0.0.1:8019

IAM_JWT_ISSUER=neorvion-iam
IAM_JWT_AUDIENCE=neorvion-copilot
IAM_JWKS_URL=http://127.0.0.1:8010/.well-known/jwks.json
IAM_JWT_KEY_ID=jwt-v1
IAM_JWT_PUBLIC_KEY_PATH=
IAM_SNAPSHOT_TTL_SECONDS=3600
IAM_REDIS_URL=redis://127.0.0.1:6379/1
IAM_REDIS_CONNECT_TIMEOUT_SECONDS=1.5
IAM_REDIS_READ_TIMEOUT_SECONDS=1.5
IAM_AUTH_TIMEOUT_SECONDS=4
IAM_SERVICE_TOKEN_URL=http://127.0.0.1:8010/api/v1/service-tokens
# 由 IAM 平台管理员创建后注入部署 Secret；不要提交真实值。
INSIGHT_SERVICE_ID=
INSIGHT_SERVICE_SECRET=
EVALUATION_SERVICE_ID=
EVALUATION_SERVICE_SECRET=

# Copilot 必须使用独立数据库和专用账号，禁止指向 neorvion_knowledge。
DATABASE_URL=postgresql+psycopg://neorvion_copilot:change-me@127.0.0.1:5432/neorvion_copilot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
CONVERSATION_PAGE_SIZE_MAX=100
CONVERSATION_CONTEXT_TOKENS=6000
STALE_RUN_SECONDS=900

# mock 仅用于测试或本地 UI 联调，不产生模型费用。
MODEL_PROVIDER=openai_compat
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_MESSAGES=12
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_CONTEXT_CHARS=12000
GRAPH_RECURSION_LIMIT=16

ERP_BASE_URL=http://127.0.0.1:8011
ERP_JWT_AUDIENCE=neorvion-erp
ERP_CONNECT_TIMEOUT_SECONDS=3
ERP_READ_TIMEOUT_SECONDS=10
ERP_EXECUTION_TIMEOUT_SECONDS=15
# 与 ERP 的 COPILOT_EXECUTION_SECRET 完全一致；生产至少 32 字节并由 Secret 管理。
ERP_EXECUTION_SECRET=
ERP_EXECUTION_AUTHORIZATION_TTL_SECONDS=60
CONFIRMATION_TTL_SECONDS=300
APPROVAL_TTL_SECONDS=86400
ACTION_GRAPH_ENABLED=true
KNOWLEDGE_BASE_URL=http://127.0.0.1:8012
KNOWLEDGE_JWT_AUDIENCE=neorvion-knowledge
KNOWLEDGE_CONNECT_TIMEOUT_SECONDS=3
KNOWLEDGE_READ_TIMEOUT_SECONDS=12
KNOWLEDGE_TOP_K_MAX=8
KNOWLEDGE_EVIDENCE_EXCERPT_CHARS=600
EVIDENCE_HISTORY_LIMIT=40
KNOWLEDGE_HISTORY_REVALIDATION_TIMEOUT_SECONDS=5
TOOL_MAX_ROUNDS=5
TOOL_MAX_CALLS=8
TOOL_TOTAL_TIMEOUT_SECONDS=30
TOOL_MAX_RESULT_CHARS=12000
TOOL_MAX_PAGE_SIZE=50
WORKFLOW_REDIS_URL=redis://127.0.0.1:6379/0
WORKFLOW_QUEUE_KEY=copilot:workflows:v1
WORKFLOW_LEASE_SECONDS=45
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_MAX_STEPS=16
WORKFLOW_RECONCILE_MAX_ATTEMPTS=6
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_AGENTS=4
MULTI_AGENT_MAX_PARALLEL=3
MULTI_AGENT_TOTAL_TIMEOUT_SECONDS=45
MULTI_AGENT_CONTEXT_CHARS=4000
MULTI_AGENT_RESULT_CHARS=8000
EVALUATION_QUEUE_KEY=copilot:evaluations:v1
EVALUATION_LEASE_SECONDS=60
EVALUATION_WORKER_POLL_SECONDS=3
EVALUATION_MAX_CONCURRENCY=2
EVALUATION_TRACE_RETENTION_DAYS=90
INSIGHT_SCHEDULER_ENABLED=false
INSIGHT_QUEUE_KEY=copilot:insights:v1
INSIGHT_WORKER_POLL_SECONDS=3
INSIGHT_LEASE_SECONDS=60
INSIGHT_MAX_CONCURRENCY=2
INSIGHT_MAX_ATTEMPTS=3
# 生产必须开启；开发环境可关闭以便无 Redis 的纯 UI 联调。
QUOTA_ENFORCEMENT_ENABLED=false
# 单请求金额预留的可证明模型调用上限；变更时必须同步回归 Agent 调用次数。
BUDGET_MAX_MODEL_CALLS_PER_REQUEST=12

# V12 MCP 默认关闭。生产启用时三项必须同时配置；Egress Proxy 应执行 DNS/IP 固定与出站 ACL。
MCP_REMOTE_EXECUTION_ENABLED=false
MCP_ALLOWED_HOSTS=
MCP_EGRESS_PROXY_URL=
MCP_NETWORK_ISOLATION_ACKNOWLEDGED=false
MCP_BUDGET_GATE_VERIFIED=false
MCP_ORIGIN=https://copilot.neorvion.invalid
MCP_TIMEOUT_SECONDS=15
MCP_MAX_RESPONSE_BYTES=262144
MCP_MAX_TOOLS_PER_SERVER=100

# 可选回退密钥。真实密钥只放 services/copilot/.env 或部署 Secret。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

