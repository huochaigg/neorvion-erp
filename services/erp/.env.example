APP_NAME=Neorvion ERP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8011
APP_VERSION=1.0.0
GIT_SHA=
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:8015,http://localhost:8016,http://localhost:8018,http://127.0.0.1:8015,http://127.0.0.1:8016,http://127.0.0.1:8018

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neorvion
MYSQL_PASSWORD=neorvion_dev
MYSQL_DATABASE=neorvion_erp
MYSQL_TEST_DATABASE=neorvion_erp_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# IAM JWT 校验。生产必须配置 IAM_JWKS_URL，公钥不要写进镜像。
IAM_JWT_ISSUER=neorvion-iam
IAM_JWT_AUDIENCE=neorvion-erp
IAM_JWKS_URL=http://127.0.0.1:8010/.well-known/jwks.json
IAM_JWT_KEY_ID=jwt-v1
IAM_JWT_PUBLIC_KEY_PATH=
IAM_SNAPSHOT_TTL_SECONDS=3600
IAM_AUTHORIZE_URL=http://127.0.0.1:8010/api/v1/internal/authorize
IAM_INTERNAL_KEY=
IAM_REDIS_HOST=127.0.0.1
IAM_REDIS_PORT=6379
IAM_REDIS_PASSWORD=
IAM_REDIS_DB=1

EXPORT_DIR=./var/exports
DEMO_EMAIL=
DEMO_PASSWORD=
