APP_NAME=Neorvion IAM
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010
ENABLE_API_DOCS=true

JWT_ISSUER=neorvion-iam
JWT_AUDIENCES=neorvion-iam,neorvion-erp,neorvion-knowledge,neorvion-copilot
JWT_KEY_ID=jwt-v1
JWT_PRIVATE_KEY_PATH=secrets/jwt/v1/private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt/v1/public.pem
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=neorvion_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=neorvion_csrf
CSRF_COOKIE_PATH=/

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neorvion
MYSQL_PASSWORD=neorvion_dev
MYSQL_DATABASE=neorvion_iam
MYSQL_TEST_DATABASE=neorvion_iam_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

RSA_KEY_ID=v1
RSA_PRIVATE_KEY_PATH=secrets/rsa/v1/private.pem
RSA_PUBLIC_KEY_PATH=secrets/rsa/v1/public.pem
RSA_CHALLENGE_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:8015,http://localhost:8016,http://localhost:8017,http://localhost:8018,http://localhost:8019,http://127.0.0.1:8015,http://127.0.0.1:8016,http://127.0.0.1:8017,http://127.0.0.1:8018,http://127.0.0.1:8019

PERMISSION_SYNC_KEY=
INTERNAL_SERVICE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SNAPSHOT_TTL_SECONDS=3600
