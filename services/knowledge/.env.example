APP_NAME=Neorvion Knowledge
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8012
APP_VERSION=3.0.0
GIT_SHA=
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:8015,http://localhost:8017,http://127.0.0.1:8015,http://127.0.0.1:8017

# PostgreSQL。密码只写本地 .env，不要提交真实值。
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/neorvion_knowledge
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/neorvion_knowledge_test

# 与 ERP 的 SECRET_KEY / JWT_ALGORITHM 保持一致，仅用于本地校验 Access Token 签名。
# 权限与租户成员仍必须走 ERP 身份内省，不能只靠共享 JWT Secret。
ERP_JWT_SECRET=change-me-in-local-dev
ERP_JWT_ALGORITHM=HS256
ERP_API_BASE_URL=http://127.0.0.1:8011
ERP_INTERNAL_SERVICE_KEY=change-me-internal-service-key
IDENTITY_CACHE_TTL_SECONDS=30

# 本地文件存储根目录。不要指向仓库源码目录以外的敏感路径。
STORAGE_ROOT=./var/storage
REDIS_URL=redis://127.0.0.1:6379/0
# redis：API 只入队，需另开 Worker；inline：请求内执行，仅建议测试使用。
TASK_EXECUTOR=redis
TASK_QUEUE_KEY=knowledge:tasks
WORKER_CONCURRENCY=1
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=20971520

# V3 模型。密钥只放服务端 .env，不要提交真实值。openai_compat 兼容 Qwen 等。
# 测试请用 MODEL_PROVIDER=mock。
MODEL_PROVIDER=openai_compat
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=
CHAT_MODEL=qwen-plus
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
MODEL_TIMEOUT_SECONDS=30
