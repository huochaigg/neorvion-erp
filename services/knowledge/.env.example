APP_NAME=Neorvion Knowledge
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8012
APP_VERSION=5.0.0
GIT_SHA=
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:8015,http://localhost:8017,http://localhost:8018,http://127.0.0.1:8015,http://127.0.0.1:8017,http://127.0.0.1:8018

# PostgreSQL。密码只写本地 .env，不要提交真实值。
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/neorvion_knowledge
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/neorvion_knowledge_test

# IAM JWT 校验。Knowledge 不再调用 ERP 身份内省。生产必须配置 IAM_JWKS_URL。
IAM_JWT_ISSUER=neorvion-iam
IAM_JWT_AUDIENCE=neorvion-knowledge
IAM_JWKS_URL=http://127.0.0.1:8010/.well-known/jwks.json
IAM_JWT_KEY_ID=jwt-v1
IAM_JWT_PUBLIC_KEY_PATH=
IAM_REDIS_URL=redis://127.0.0.1:6379/1

# 本地文件存储根目录。不要指向仓库源码目录以外的敏感路径。
STORAGE_ROOT=./var/storage
REDIS_URL=redis://127.0.0.1:6379/0
# redis：API 只入队，需另开 Worker；inline：请求内执行，仅建议测试使用。
TASK_EXECUTOR=redis
TASK_QUEUE_KEY=knowledge:tasks
WORKER_CONCURRENCY=1
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=20971520

# 模型。密钥只放服务端 .env，不要提交真实值。测试请用 MODEL_PROVIDER=mock。
# Chat / Embedding / Rerank 可使用不同 Provider、Base URL、API Key。
MODEL_PROVIDER=openai_compat
CHAT_PROVIDER=openai_compat
EMBEDDING_PROVIDER=openai_compat
RERANK_PROVIDER=dashscope

# DeepSeek OpenAI 兼容 Chat。当前官方模型 ID：deepseek-flash（不要再用 gpt-4o-mini）。
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=
# 未设 CHAT_API_KEY 时回退。
DEEPSEEK_API_KEY=

# 阿里云百炼 Embedding：OpenAI 兼容 Embeddings。请使用本机已开通工作空间的地址，不要改成 OpenAI 官方。
# 例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_KEY=
# Embedding 与 Rerank 可共用。未设 EMBEDDING_API_KEY / RERANK_API_KEY 时回退。
DASHSCOPE_API_KEY=

# 百炼 qwen3-rerank 走原生 text-rerank 协议，不是 Chat Completions。
# RERANK_BASE_URL 留空时，从 EMBEDDING_BASE_URL 的工作空间 host 推导
# https://{WorkspaceId}.{region}.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_BASE_URL=
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
MODEL_TIMEOUT_SECONDS=30
EVAL_MAX_CASES=200
EVAL_TOKEN_BUDGET=200000
EVAL_PROMPT_TOKEN_USD=0
EVAL_COMPLETION_TOKEN_USD=0
