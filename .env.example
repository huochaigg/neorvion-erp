APP_NAME=Neorvion ERP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8011

# 生产环境必须替换。不要把真实密钥提交到仓库。
SECRET_KEY=change-me-in-local-dev

JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=neorvion_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:8015,http://localhost:8016,http://127.0.0.1:8015,http://127.0.0.1:8016

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neorvion
MYSQL_PASSWORD=neorvion_dev
MYSQL_DATABASE=neorvion_erp
MYSQL_TEST_DATABASE=neorvion_erp_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 同一 PostgreSQL 实例内使用两个独立数据库。生产密码必须由 Secret 注入。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neorvion_knowledge
COPILOT_POSTGRES_USER=neorvion_copilot
COPILOT_POSTGRES_PASSWORD=change-me
COPILOT_POSTGRES_DB=neorvion_copilot

# RSA 传输加密。与 SECRET_KEY / JWT 分开，私钥不要提交 Git。
RSA_KEY_ID=v1
RSA_PRIVATE_KEY_PATH=secrets/rsa/v1/private.pem
RSA_PUBLIC_KEY_PATH=secrets/rsa/v1/public.pem
RSA_PREVIOUS_KEY_ID=
RSA_PREVIOUS_PRIVATE_KEY_PATH=
RSA_CHALLENGE_TTL_SECONDS=300

VITE_API_BASE_URL=http://localhost:8011
VITE_ERP_ENTRY=http://localhost:8016
VITE_COPILOT_ENTRY=http://localhost:8019

# Copilot :8013。真实模型密钥只放 services/copilot/.env 或部署 Secret。
COPILOT_MODEL_PROVIDER=openai_compat
COPILOT_CHAT_BASE_URL=https://api.deepseek.com
COPILOT_CHAT_API_KEY=
COPILOT_CHAT_MODEL=deepseek-chat
COPILOT_KNOWLEDGE_BASE_URL=http://knowledge:8012
COPILOT_KNOWLEDGE_TOP_K_MAX=8
COPILOT_KNOWLEDGE_EVIDENCE_EXCERPT_CHARS=600
COPILOT_TOOL_MAX_ROUNDS=5
COPILOT_TOOL_MAX_CALLS=8
COPILOT_TOOL_TOTAL_TIMEOUT_SECONDS=30
COPILOT_TOOL_MAX_RESULT_CHARS=12000
COPILOT_EXECUTION_SECRET=
COPILOT_WORKFLOW_QUEUE_KEY=copilot:workflows:v1
COPILOT_WORKFLOW_LEASE_SECONDS=45
COPILOT_WORKFLOW_MAX_ATTEMPTS=3
COPILOT_WORKFLOW_RECONCILE_MAX_ATTEMPTS=6
COPILOT_MULTI_AGENT_ENABLED=true
COPILOT_MULTI_AGENT_MAX_PARALLEL=3
COPILOT_EVALUATION_QUEUE_KEY=copilot:evaluations:v1
COPILOT_EVALUATION_LEASE_SECONDS=60
COPILOT_EVALUATION_MAX_CONCURRENCY=2
COPILOT_EVALUATION_TRACE_RETENTION_DAYS=90
COPILOT_MCP_REMOTE_EXECUTION_ENABLED=false
COPILOT_MCP_ALLOWED_HOSTS=
COPILOT_MCP_EGRESS_PROXY_URL=
COPILOT_MCP_NETWORK_ISOLATION_ACKNOWLEDGED=false
COPILOT_MCP_BUDGET_GATE_VERIFIED=false

# 仅本地 / 演示环境 seed 使用。公开部署请用平台 Secret，不要把真实密码提交到 Git。
DEMO_EMAIL=
DEMO_PASSWORD=
