# ===== 后端 =====
APP_NAME=Neorvion ERP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# 生产环境必须替换。不要把真实密钥提交到仓库。
SECRET_KEY=change-me-in-local-dev

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# CORS：主应用与 ERP 子应用开发源
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL（Docker Compose 默认账号，本地已有实例时请改成自己的连接信息）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neorvion
MYSQL_PASSWORD=neorvion_dev
MYSQL_DATABASE=neorvion_erp

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 前端（也可分别放在 apps/shell/.env 与 apps/erp/.env）=====
VITE_API_BASE_URL=http://localhost:8001
VITE_ERP_ENTRY=http://localhost:5174
