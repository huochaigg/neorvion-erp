APP_NAME=Neorvion ERP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8011

# 生产环境必须替换。不要把真实密钥提交到仓库。
SECRET_KEY=change-me-in-local-dev

JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=neorvion_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:8015,http://localhost:8016,http://127.0.0.1:8015,http://127.0.0.1:8016

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neorvion
MYSQL_PASSWORD=neorvion_dev
MYSQL_DATABASE=neorvion_erp
MYSQL_TEST_DATABASE=neorvion_erp_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RSA 传输加密。与 SECRET_KEY / JWT 分开，私钥不要提交 Git。
RSA_KEY_ID=v1
RSA_PRIVATE_KEY_PATH=secrets/rsa/v1/private.pem
RSA_PUBLIC_KEY_PATH=secrets/rsa/v1/public.pem
RSA_PREVIOUS_KEY_ID=
RSA_PREVIOUS_PRIVATE_KEY_PATH=
RSA_CHALLENGE_TTL_SECONDS=300

VITE_API_BASE_URL=http://localhost:8011
VITE_ERP_ENTRY=http://localhost:8016
